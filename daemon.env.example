# sponsord configuration
# Copy to daemon.env and adjust as needed

# --- Required ---

# Bearer token callers present; at least 32 bytes. Generate one with
# `openssl rand -hex 32`. The daemon refuses to start while this is empty.
SPONSORD_API_TOKEN=
# ...or SPONSORD_API_TOKEN_FILE=/run/secrets/api-token
SPONSORD_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
SPONSORD_PAYMENT_POOL_ADDR=0x...
SPONSORD_POOL_ID=0x...
SPONSORD_TREASURY_KEYSTORE=/path/to/treasury-keystore.json
SPONSORD_TREASURY_PASSWORD=changeme
# ...or SPONSORD_TREASURY_PASSWORD_FILE=/run/secrets/treasury-password

# --- Optional (defaults shown) ---

SPONSORD_BIND=127.0.0.1:8090
SPONSORD_CHAIN_ID=421614
# Largest cap a caller may request per capability, in micro-USDC (5_000_000 = $5)
SPONSORD_MAX_SPENDING_CAP_MICRO_USDC=5000000
# Longest TTL a caller may request, in seconds (172_800 = 48h)
SPONSORD_MAX_TTL_SECS=172800
# Tops the pool up when its remaining balance drops below this, in micro-USDC ($20)
SPONSORD_POOL_LOW_WATER_MICRO_USDC=20000000
# Amount the pool is topped up by, in micro-USDC ($100)
SPONSORD_POOL_REFILL_MICRO_USDC=100000000
# How often the pool balance is checked, in seconds
SPONSORD_POOL_WATCH_INTERVAL_SECS=3600
