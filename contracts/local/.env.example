# contracts/local/.env.example — copy to `.env` and edit.
# `.env` is gitignored (repo-root rule). Both docker-compose.yml and deploy.sh
# read this file.

# --- Networking ------------------------------------------------------------
#
# This rig is LOCAL-ONLY: docker-compose.yml publishes anvil's port to
# 127.0.0.1. anvil's RPC is unauthenticated and ships well-known dev keys, so do
# not expose it directly — a shared/team test RPC (and its hardening) is the
# devops test-RPC setup's job, not this rig's.

# Host port for the anvil RPC (published on 127.0.0.1).
RPC_PORT=8545

# RPC the deploy script targets. Defaults to http://127.0.0.1:$RPC_PORT.
# RPC_URL=http://127.0.0.1:8545

# --- Chain -----------------------------------------------------------------

# Chain id. Kept in the 3133769x range so the generated
# deployments/<chainId>.json manifest is gitignored (never committed). Pick a
# stable value your nodes can hardcode.
CHAIN_ID=31337699

# Seconds per block. Non-zero advances chain time without txs (more realistic
# for epoch / dispute-window / unbonding logic). Set 0 for instant on-demand
# mining only.
BLOCK_TIME=2

# Foundry image for anvil. Pin a digest in real use, e.g.
# ghcr.io/foundry-rs/foundry@sha256:<digest>
FOUNDRY_IMAGE=ghcr.io/foundry-rs/foundry:latest

# --- iroh relay (optional; `docker compose --profile relay up -d`) ----------

# Image/build for the self-hosted iroh relay. No default — iroh publishes no
# official relay image, so supply one you build (e.g. `cargo install iroh-relay`
# baked into a slim image). Only needed if you route nodes through a local relay
# via [network] relay_url = http://127.0.0.1:3340. See README § iroh relay.
# IROH_RELAY_IMAGE=your-registry/iroh-relay:dev

# --- Deploy ----------------------------------------------------------------

# Governance timelock delay (seconds). Floor is 3600 (1h) — the deploy script
# rejects anything lower. 1h keeps governance ops tractable for testing; you can
# also fast-forward with `cast rpc evm_increaseTime <secs> && cast rpc evm_mine`.
TIMELOCK_DELAY=3600

# 1B TOKEN recipient at genesis. Defaults to the deployer (anvil dev acct #0).
# INITIAL_TOKEN_HOLDER=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# Broadcaster for the deploy. Defaults to anvil dev account #0 (mnemonic
# "test test test ... junk"), funded at genesis. THROWAWAY key — never real.
# DEPLOYER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# DEPLOYER_ADDR=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
