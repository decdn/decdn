.env
.env.*
.claude.local.md

# Git worktrees
/.worktrees/
.claude/worktrees

# Claude Code harness runtime artifacts
.claude/scheduled_tasks.lock

# deploy/sponsord/compose.yaml secrets and filled-in env files
/deploy/sponsord/secrets/
/deploy/sponsord/*.env
# Release binaries staged for a local `docker build` (see Dockerfile)
/dist/

# Rust / Cargo
/target/
# `cargo llvm-cov nextest --cobertura` output (the CI `test` job's command)
/cobertura.xml

# Foundry
/contracts/out/
/contracts/cache/
/contracts/broadcast/
/contracts/docs/

# solc compiler blob (downloaded for local Solidity builds)
/soljson-latest.js

# ADR PDF build output
/adr/adrs.pdf
/adr/adrs-book.pdf
mermaid-filter.err

# cargo-semver-checks-action scratch dir; left in the tree, would make
# cargo-release's clean-tree check fail during the release workflow
/semver-checks/

# Python
__pycache__/
*.py[cod]
*$py.class
