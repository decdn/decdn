# sponsord configuration
# Copy to .env and adjust as needed

# --- Required ---

SPONSOR_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
SPONSOR_PAYMENT_POOL_ADDR=0x...
SPONSOR_POOL_ID=0x...
SPONSOR_CAPACITY_BOND_ADDR=0x...
SPONSOR_TREASURY_KEYSTORE=/path/to/treasury-keystore.json
SPONSOR_TREASURY_PASSWORD=changeme
SPONSOR_TURNSTILE_SECRET=0x...
SPONSOR_TURNSTILE_SITEKEY=0x...

# --- Optional (defaults shown) ---

SPONSOR_BIND=127.0.0.1:8080
SPONSOR_PUBLIC_URL=https://up.decdn.org
SPONSOR_CHAIN_ID=421614
# Cap baked into each issued capability, in micro-USDC (10_000_000 = $10)
SPONSOR_CAPABILITY_CAP_MICRO_USDC=10000000
# How long an issued capability remains valid, in seconds (2_592_000 = 30d)
SPONSOR_CAPABILITY_TTL_SECS=2592000
# Treasury tops the pool up when its remaining balance drops below this, in micro-USDC ($20)
SPONSOR_POOL_LOW_WATER_MICRO_USDC=20000000
# Amount the treasury tops the pool up by, in micro-USDC ($100)
SPONSOR_POOL_REFILL_MICRO_USDC=100000000
# How often the pool_watch background task checks the pool balance, in seconds
SPONSOR_POOL_WATCH_INTERVAL_SECS=3600
SPONSOR_DATA_DIR=./data
