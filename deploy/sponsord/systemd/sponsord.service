# sponsord as a systemd service. Secrets come in as credentials, readable
# only by this service, never as environment variables:
#
#   install -m 0600 api-token treasury-password treasury-keystore.json /etc/sponsord/
#   install -m 0644 sponsord.env /etc/sponsord/sponsord.env   # no secrets in it
#   systemctl enable --now sponsord
[Unit]
Description=sponsord: capability signing and pool top-ups
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/sponsord
EnvironmentFile=/etc/sponsord/sponsord.env
LoadCredential=api-token:/etc/sponsord/api-token
LoadCredential=treasury-password:/etc/sponsord/treasury-password
LoadCredential=treasury-keystore.json:/etc/sponsord/treasury-keystore.json
Environment=SPONSORD_API_TOKEN_FILE=%d/api-token
Environment=SPONSORD_TREASURY_PASSWORD_FILE=%d/treasury-password
# Some systemd versions (254+ on Linux 6.4+, seen on 255) load credentials at
# mode 0440, and the daemon refuses a keystore with any group or other bit
# set. So copy it to a private 0600 file first. The copy is still the
# encrypted keystore, the password stays in %d, and systemd removes
# /run/sponsord when the service stops.
RuntimeDirectory=sponsord
RuntimeDirectoryMode=0700
ExecStartPre=/usr/bin/install -m 0600 %d/treasury-keystore.json %t/sponsord/treasury-keystore.json
Environment=SPONSORD_TREASURY_KEYSTORE=%t/sponsord/treasury-keystore.json
DynamicUser=yes
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
