# sponsord configuration. Every setting is also a flag: `sponsord --help`.
# Secrets (API token, keystore password) are best given as files, see
# compose.yaml and systemd/sponsord.service.

# --- Required ---

SPONSORD_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
SPONSORD_PAYMENT_POOL_ADDR=0x...
# Your pool, opened once with `decdn pool open` from the treasury wallet
SPONSORD_POOL_ID=0x...
# Bearer token callers present, at least 32 bytes (`openssl rand -hex 32`):
# SPONSORD_API_TOKEN=...  or  SPONSORD_API_TOKEN_FILE=/run/secrets/api-token
# The treasury wallet's keystore, and its password:
# SPONSORD_TREASURY_KEYSTORE=/path/to/treasury-keystore.json
# SPONSORD_TREASURY_PASSWORD=...  or  SPONSORD_TREASURY_PASSWORD_FILE=/run/secrets/treasury-password

# --- Optional (defaults shown) ---

# SPONSORD_BIND=127.0.0.1:8090
# SPONSORD_CHAIN_ID=421614
# Largest cap per capability, in micro-USDC ($5)
# SPONSORD_MAX_SPENDING_CAP_MICRO_USDC=5000000
# Longest TTL per capability, in seconds (48 hours)
# SPONSORD_MAX_TTL_SECS=172800
# Top the pool up below this, in micro-USDC ($20)
# SPONSORD_POOL_LOW_WATER_MICRO_USDC=20000000
# Each top-up adds this, in micro-USDC ($100)
# SPONSORD_POOL_REFILL_MICRO_USDC=100000000
# How often the pool balance is checked, in seconds
# SPONSORD_POOL_WATCH_INTERVAL_SECS=3600
