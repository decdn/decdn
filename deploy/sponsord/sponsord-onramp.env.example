# sponsord-onramp configuration. Every setting is also a flag:
# `sponsord-onramp --help`. Secrets (daemon token, Turnstile secret) are best
# given as files, see compose.yaml and systemd/sponsord-onramp.service.

# --- Required ---

# This onramp's public base URL, as users reach it
ONRAMP_PUBLIC_URL=https://downloads.example.org
# Public RPC endpoint end users' decdn reads the chain through
ONRAMP_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ONRAMP_CAPACITY_BOND_ADDR=0x...
ONRAMP_TURNSTILE_SITEKEY=0x...
# The daemon's API token, and the Turnstile secret:
# ONRAMP_DAEMON_TOKEN=...  or  ONRAMP_DAEMON_TOKEN_FILE=/run/secrets/api-token
# ONRAMP_TURNSTILE_SECRET=...  or  ONRAMP_TURNSTILE_SECRET_FILE=/run/secrets/turnstile-secret
# The decdn release the installers install: its tag (vX.Y.Z, v0.3.0 or
# later: the installers rely on `decdn get` picking the destination and
# refusing hidden paths) and the SHA-256 of its SHA256SUMS file
ONRAMP_DECDN_RELEASE=v0.3.0
ONRAMP_DECDN_SUMS_SHA256=<SHA-256 of v0.3.0's SHA256SUMS>
# The header your reverse proxy puts the client address in. compose.yaml and
# the systemd unit bind the onramp to localhost, so the proxy is the only way
# in; without this header every client shares the proxy's rate-limit budget.
# X-Forwarded-For suits a proxy that appends the address it saw (Caddy,
# nginx); behind Cloudflare, with an origin only Cloudflare can reach, use
# CF-Connecting-IP. Leave it unset only if clients reach the onramp directly.
ONRAMP_CLIENT_IP_HEADER=X-Forwarded-For

# --- Optional (defaults shown) ---

# ONRAMP_BIND=127.0.0.1:8080
# ONRAMP_DAEMON_URL=http://127.0.0.1:8090
# Requested per capability; unset takes the daemon maximum
# ONRAMP_SPENDING_CAP_MICRO_USDC=
# ONRAMP_TTL_SECS=
# ONRAMP_SLASH_JUDGE_ADDR=
# ONRAMP_GATE=turnstile
# ONRAMP_BRAND_NAME=deCDN
# Your own gate page (HTML); see docs/sponsord/operator.md for its placeholders
# ONRAMP_GATE_TEMPLATE=
# ONRAMP_FUND_RATE_PER_MIN=10
# ONRAMP_POLL_RATE_PER_MIN=120
# ONRAMP_RELEASES_BASE=https://github.com/decdn
